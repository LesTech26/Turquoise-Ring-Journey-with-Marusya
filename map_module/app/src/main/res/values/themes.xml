<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TRJWM" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/turquoise_500</item>
        <item name="colorPrimaryVariant">@color/blue_500</item>
        <item name="colorSecondary">@color/gold_500</item>
        <item name="colorSecondaryVariant">@color/walnut_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/ink_900</item>
        <item name="android:statusBarColor">@color/blue_500</item>
        <item name="android:navigationBarColor">@color/beige_100</item>
        <item name="android:windowBackground">@color/beige_100</item>
        <item name="materialCardViewStyle">@style/Widget.TRJWM.Card</item>
    </style>

    <style name="Widget.TRJWM.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/mint_200</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>
</resources>
