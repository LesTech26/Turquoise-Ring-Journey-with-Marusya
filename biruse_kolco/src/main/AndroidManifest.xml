<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.example.biruse_kolco.BiruseKolcoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BiruseKolco"
        android:forceDarkAllowed="false"
        android:persistent="false"
        android:clearTaskOnLaunch="true"
        tools:targetApi="31">

        <activity
            android:name="com.example.biruse_kolco.ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.BiruseKolco.Splash"
            android:forceDarkAllowed="false"
            android:launchMode="singleTop"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.biruse_kolco.ui.main.MainActivity"
            android:exported="false"
            android:forceDarkAllowed="false"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:finishOnTaskLaunch="true"
            android:excludeFromRecents="false" />

    </application>

</manifest>
