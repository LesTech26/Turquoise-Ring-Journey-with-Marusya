<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BiruseKolco" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/orel_green</item>
        <item name="colorPrimaryVariant">@color/orel_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orel_gold</item>
        <item name="colorSecondaryVariant">@color/orel_gold_dark</item>
        <item name="colorOnSecondary">@color/orel_dark</item>
        <item name="android:statusBarColor">@color/orel_green_dark</item>
        <item name="android:navigationBarColor">@color/orel_cream</item>
        <item name="android:windowBackground">@color/orel_cream</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="bottomNavigationStyle">@style/Widget.BiruseKolco.BottomNavigation</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
    </style>

    <style name="Theme.BiruseKolco.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/background_splash</item>
        <item name="android:statusBarColor">@color/orel_green_dark</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Widget.BiruseKolco.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemBackground">@drawable/bg_bottom_nav_item</item>
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="WindowAnimationTransition" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
