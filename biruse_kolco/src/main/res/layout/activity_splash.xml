<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gerb"
    android:backgroundTint="@null">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Золотой текст - максимально выше -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="160dp">

            <TextView
                android:id="@+id/tv_splash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lobster"
                android:text="ПУТЕШЕСТВИЕ ПО"
                android:textColor="@color/orel_gold"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:alpha="0"
                android:translationY="40dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"/>

            <TextView
                android:id="@+id/tv_splash_title_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lobster"
                android:text="БИРЮЗОВОМУ КОЛЬЦУ"
                android:textColor="@color/orel_gold"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:alpha="0"
                android:translationY="40dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"/>

            <TextView
                android:id="@+id/tv_splash_title_third"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lobster"
                android:text="РОССИИ"
                android:textColor="@color/orel_gold"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:alpha="0"
                android:translationY="40dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"/>

        </LinearLayout>

        <!-- Белый текст + загрузка - максимально ниже -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="90dp">

            <TextView
                android:id="@+id/tv_splash_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/comfortaa"
                android:text="ОТКРОЙ ТРАДИЦИИ"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:letterSpacing="0.08"
                android:alpha="0"
                android:translationY="30dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"/>

            <TextView
                android:id="@+id/tv_splash_subtitle_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/comfortaa"
                android:text="ОРЛОВСКОЙ ОБЛАСТИ"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:letterSpacing="0.08"
                android:alpha="0"
                android:translationY="30dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"/>

            <!-- Анимированные точки загрузки -->
            <LinearLayout
                android:id="@+id/loading_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:alpha="0">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_dot"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_dot"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_dot" />

            </LinearLayout>

            <!-- Версия -->
            <TextView
                android:id="@+id/tv_splash_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/rubik"
                android:text="v1.0"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:alpha="0"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>