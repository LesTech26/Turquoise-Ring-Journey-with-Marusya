    showDialog(dialogId, data = {}) {
        const dialog = this.dialogs[dialogId];
        if (!dialog) {
            console.warn(`Dialog "${dialogId}" not found`);
            return;
        }

        this.currentDialog = dialog;
        this.isActive = true;
        this.currentNode = dialogId;

        // Обработка переменных в тексте
        let text = dialog.text;
        if (data) {
            Object.keys(data).forEach(key => {
                text = text.replace(`{${key}}`, data[key]);
            });
        }

        // Сохраняем данные для подстановки
        this.currentData = data;

        const container = document.querySelector(this.container);
        container.classList.remove('hidden');

        // Очищаем предыдущие сообщения и варианты
        const messagesContainer = container.querySelector('.dialog-messages');
        const choicesContainer = container.querySelector('.dialog-choices');
        
        // Оставляем только шаблон сообщения
        messagesContainer.innerHTML = '';
        choicesContainer.innerHTML = '';

        // Добавляем сообщение от Маруси
        this.addMessage(text, dialog.speaker || 'marusya', dialog.type);

        // Добавляем варианты ответа
        this.addChoices(dialog.choices, data);

        // Показываем индикатор печати
        this.showTypingIndicator();

        // Обновляем состояние маскота
        this.updateMascotState(dialog.type);

        // Воспроизводим звук (если включено)
        if (this.audioEnabled) {
            this.playDialogSound(dialog.type);
        }

        // Триггерим событие для аналитики
        this.trackDialogEvent('show', dialogId, data);

        // Сохраняем в историю
        this.history.push({ dialogId, data, timestamp: new Date() });
    }

    addMessage(text, speaker, type = 'info') {
        const container = document.querySelector(this.container);
        const messagesContainer = container.querySelector('.dialog-messages');

        const messageDiv = document.createElement('div');
        messageDiv.className = `message message-${speaker}`;

        // Эмоция в зависимости от типа
        const emotions = {
            greeting: '👋',
            info: '💡',
            educational: '📚',
            celebration: '🎉',
            achievement: '🏆',
            interactive: '✨',
            welcome: '🌟',
            guide: '🗺️',
            tutorial: '🎯',
            games: '🎮',
            progress: '📊',
            curious: '🤔',
            happy: '😊',
            excited: '🤩'
        };

        const emotion = emotions[type] || '💬';

        messageDiv.innerHTML = `
            <div class="message-avatar">
                <img src="/assets/img/marusya-icon.svg" alt="Маруся">
                <span class="mascot-emotion">${emotion}</span>
            </div>
            <div class="message-content">
                <div class="message-text">${this.formatText(text)}</div>
            </div>
        `;

        messagesContainer.appendChild(messageDiv);

        // Анимация печати
        this.typeMessage(messageDiv.querySelector('.message-text'), text);

        // Прокрутка вниз
        this.scrollToBottom();
    }

    formatText(text) {
        // Заменяем переносы строк на <br>
        return text.replace(/\n/g, '<br>');
    }

    typeMessage(element, text, speed = null) {
        const typingSpeed = speed || this.typingSpeed;
        element.innerHTML = '';
        let index = 0;

        // Убираем теги для подсчёта символов
        const cleanText = text.replace(/<br>/g, '\n');
        const chars = cleanText.split('');

        // Добавляем курсор
        const cursorSpan = document.createElement('span');
        cursorSpan.className = 'typing-cursor';
        element.appendChild(cursorSpan);

        const typeChar = () => {
            if (index < chars.length) {
                const char = chars[index];
                if (char === '\n') {
                    element.innerHTML += '<br>';
                } else {
                    element.innerHTML += char;
                }
                index++;
                // Убираем курсор из конца и добавляем снова
                const cursor = element.querySelector('.typing-cursor');
                if (cursor) {
                    element.removeChild(cursor);
                }
                element.appendChild(cursorSpan);

                // Случайная задержка для реалистичности
                const delay = typingSpeed + Math.random() * 20;
                setTimeout(typeChar, delay);
            } else {
                // Убираем курсор
                const cursor = element.querySelector('.typing-cursor');
                if (cursor) {
                    element.removeChild(cursor);
                }
                // Показываем индикатор готовности
                this.hideTypingIndicator();
                // Активируем варианты ответов
                this.enableChoices();
            }
        };

        setTimeout(typeChar, 300);
    }

    addChoices(choices, data = {}) {
        const container = document.querySelector(this.container);
        const choicesContainer = container.querySelector('.dialog-choices');

        if (!choices || choices.length === 0) {
            // Если нет вариантов, добавляем кнопку "Продолжить"
            const continueChoice = document.createElement('button');
            continueChoice.className = 'dialog-choice';
            continueChoice.innerHTML = '➡️ Продолжить';
            continueChoice.addEventListener('click', () => {
                this.showDialog('main');
            });
            choicesContainer.appendChild(continueChoice);
            return;
        }

        // Фильтруем варианты по условиям
        const validChoices = choices.filter(choice => {
            if (choice.condition && typeof choice.condition === 'function') {
                return choice.condition();
            }
            return true;
        });

        validChoices.forEach((choice, index) => {
            const button = document.createElement('button');
            button.className = 'dialog-choice disabled';
            button.setAttribute('data-choice-id', choice.id);
            button.setAttribute('data-next', choice.next);

            // Обработка текста с переменными
            let choiceText = choice.text;
            if (data) {
                Object.keys(data).forEach(key => {
                    choiceText = choiceText.replace(`{${key}}`, data[key]);
                });
            }

            button.innerHTML = `
                <span class="choice-emoji">${choiceText.match(/^.{1,2}/)?.[0] || '•'}</span>
                ${choiceText}
                <span class="choice-shortcut">${index + 1}</span>
            `;

            button.addEventListener('click', () => {
                this.handleChoice(choice);
            });

            choicesContainer.appendChild(button);
        });

        // Добавляем поддержку клавиатурных сокращений
        document.addEventListener('keydown', this.handleKeyPress);
    }

    handleChoice(choice) {
        // Деактивируем варианты
        this.disableChoices();

        // Добавляем сообщение с выбором пользователя
        this.addUserMessage(choice.text);

        // Переход к следующему диалогу
        if (choice.next) {
            // Проверяем, есть ли специальные действия
            if (choice.action && typeof choice.action === 'function') {
                choice.action(this.currentData);
            }

            // Специальные обработки
            if (choice.next === 'random_district') {
                this.handleRandomDistrict();
                return;
            }

            if (choice.next === 'district_list') {
                this.handleDistrictList();
                return;
            }

            if (choice.next.startsWith('game_')) {
                this.handleGameLaunch(choice.next);
                return;
            }

            setTimeout(() => {
                this.showDialog(choice.next, this.currentData);
            }, 500);
        }
    }

    addUserMessage(text) {
        const container = document.querySelector(this.container);
        const messagesContainer = container.querySelector('.dialog-messages');

        const messageDiv = document.createElement('div');
        messageDiv.className = 'message message-user';

        // Убираем эмодзи из текста для чистоты
        const cleanText = text.replace(/^.{1,2}\s/, '');

        messageDiv.innerHTML = `
            <div class="message-content user-message">
                <div class="message-text">${cleanText}</div>
            </div>
        `;

        messagesContainer.appendChild(messageDiv);
        this.scrollToBottom();
    }

    handleRandomDistrict() {
        // Получаем список районов из API или из данных
        fetch('/api/districts/list')
            .then(response => response.json())
            .then(districts => {
                if (districts.length > 0) {
                    const random = districts[Math.floor(Math.random() * districts.length)];
                    window.location.href = `/district/${random.slug}`;
                }
            })
            .catch(() => {
                // Если API недоступен, используем заглушку
                const districts = ['bolkhovsky', 'verkhovsky', 'glazunovsky'];
                const random = districts[Math.floor(Math.random() * districts.length)];
                window.location.href = `/district/${random}`;
            });
    }

    handleDistrictList() {
        // Показываем список районов в диалоге
        const container = document.querySelector(this.container);
        const choicesContainer = container.querySelector('.dialog-choices');
        choicesContainer.innerHTML = '';

        fetch('/api/districts/list')
            .then(response => response.json())
            .then(districts => {
                // Показываем первые 6 районов с пагинацией
                const displayDistricts = districts.slice(0, 6);
                displayDistricts.forEach(district => {
                    const button = document.createElement('button');
                    button.className = 'dialog-choice';
                    button.innerHTML = `📍 ${district.name}`;
                    button.addEventListener('click', () => {
                        window.location.href = `/district/${district.slug}`;
                    });
                    choicesContainer.appendChild(button);
                });

                if (districts.length > 6) {
                    const moreButton = document.createElement('button');
                    moreButton.className = 'dialog-choice';
                    moreButton.innerHTML = '📋 Показать все районы';
                    moreButton.addEventListener('click', () => {
                        window.location.href = '/districts';
                    });
                    choicesContainer.appendChild(moreButton);
                }

                const backButton = document.createElement('button');
                backButton.className = 'dialog-choice';
                backButton.innerHTML = '⬅️ Назад';
                backButton.addEventListener('click', () => {
                    this.showDialog('district_menu');
                });
                choicesContainer.appendChild(backButton);
            })
            .catch(() => {
                // Fallback
                this.showDialog('main');
            });
    }

    handleGameLaunch(gameId) {
        // Запуск игры с уведомлением
        const gameNames = {
            'game_quiz_start': 'Викторина',
            'game_costume_start': 'Собери костюм',
            'game_puzzle_start': 'Пазл',
            'game_memory_start': 'Мемори'
        };

        const gameName = gameNames[gameId] || 'игра';

        const container = document.querySelector(this.container);
        const choicesContainer = container.querySelector('.dialog-choices');
        
        // Добавляем сообщение о запуске игры
        const gameMessage = document.createElement('div');
        gameMessage.className = 'message message-marusya';
        gameMessage.innerHTML = `
            <div class="message-avatar">
                <img src="/assets/img/marusya-icon.svg" alt="Маруся">
            </div>
            <div class="message-content">
                <div class="message-text">🎮 Отлично! Запускаю ${gameName}...</div>
            </div>
        `;
        const messagesContainer = container.querySelector('.dialog-messages');
        messagesContainer.appendChild(gameMessage);
        this.scrollToBottom();

        // Переход на страницу игры через 1 секунду
        setTimeout(() => {
            window.location.href = `/games#${gameId.replace('game_', '').replace('_start', '')}`;
        }, 1000);
    }

    updateMascotState(type) {
        // Обновляем состояние маскота в зависимости от типа диалога
        const states = {
            greeting: 'happy',
            info: 'neutral',
            educational: 'thinking',
            celebration: 'excited',
            achievement: 'happy',
            interactive: 'curious',
            welcome: 'happy',
            guide: 'pointing',
            tutorial: 'explaining',
            games: 'excited',
            progress: 'proud',
            curious: 'curious',
            happy: 'happy',
            excited: 'excited'
        };

        const state = states[type] || 'neutral';
        
        // Отправляем событие для управления маскотом
        document.dispatchEvent(new CustomEvent('mascot:setState', {
            detail: { state }
        }));
    }

    mascotReaction(type = 'curious') {
        // Реакция маскота на клик
        this.updateMascotState(type);
        
        // Показываем случайную фразу
        const phrases = {
            curious: ['Хм... интересно!', 'Что это?', 'Ой, смотри-ка!'],
            happy: ['Как здорово!', 'Ура!', 'Отлично!'],
            thinking: ['Дай-ка подумать...', 'Сейчас вспомню...', 'Ага, знаю!']
        };

        const selectedPhrases = phrases[type] || phrases.curious;
        const phrase = selectedPhrases[Math.floor(Math.random() * selectedPhrases.length)];

        // Показываем всплывающую подсказку
        this.showFloatingText(phrase, type);
    }

    showFloatingText(text, type = 'neutral') {
        const container = document.querySelector(this.container);
        if (!container) return;

        const floatText = document.createElement('div');
        floatText.className = `float-text float-${type}`;
        floatText.textContent = text;

        const position = container.getBoundingClientRect();
        floatText.style.left = `${Math.random() * 100}px`;
        floatText.style.top = `-30px`;

        container.querySelector('.dialog-window').appendChild(floatText);

        // Анимация появления и исчезновения
        setTimeout(() => {
            floatText.remove();
        }, 2000);
    }

    showTypingIndicator() {
        const container = document.querySelector(this.container);
        const indicator = container.querySelector('.dialog-typing-indicator');
        if (indicator) {
            indicator.classList.remove('hidden');
        }
        // Отключаем варианты ответов
        this.disableChoices();
    }

    hideTypingIndicator() {
        const container = document.querySelector(this.container);
        const indicator = container.querySelector('.dialog-typing-indicator');
        if (indicator) {
            indicator.classList.add('hidden');
        }
        this.enableChoices();
    }

    disableChoices() {
        const container = document.querySelector(this.container);
        const choices = container.querySelectorAll('.dialog-choice');
        choices.forEach(choice => {
            choice.classList.add('disabled');
            choice.style.pointerEvents = 'none';
        });
    }

    enableChoices() {
        const container = document.querySelector(this.container);
        const choices = container.querySelectorAll('.dialog-choice');
        choices.forEach(choice => {
            choice.classList.remove('disabled');
            choice.style.pointerEvents = 'auto';
        });
    }

    scrollToBottom() {
        const container = document.querySelector(this.container);
        const body = container.querySelector('.dialog-body');
        if (body) {
            body.scrollTop = body.scrollHeight;
        }
    }

    hideDialog() {
        const container = document.querySelector(this.container);
        container.classList.add('hidden');
        this.isActive = false;
        document.removeEventListener('keydown', this.handleKeyPress);
    }

    handleKeyPress = (e) => {
        if (!this.isActive) return;

        // Цифровые клавиши для выбора вариантов
        const num = parseInt(e.key);
        if (num >= 1 && num <= 9) {
            const choices = document.querySelectorAll('.dialog-choice:not(.disabled)');
            if (choices[num - 1]) {
                choices[num - 1].click();
            }
        }

        // Клавиша Escape для закрытия
        if (e.key === 'Escape') {
            this.hideDialog();
        }

        // Стрелка вниз/вверх для навигации
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            const choices = document.querySelectorAll('.dialog-choice:not(.disabled)');
            const currentIndex = Array.from(choices).findIndex(c => c === document.activeElement);
            let newIndex = e.key === 'ArrowDown' 
                ? Math.min(currentIndex + 1, choices.length - 1)
                : Math.max(currentIndex - 1, 0);
            if (choices[newIndex]) {
                choices[newIndex].focus();
            }
        }
    }

    showInitialDialog() {
        // Проверяем, был ли пользователь уже на сайте
        const hasVisited = localStorage.getItem('marusya_visited');
        const dialogId = hasVisited ? 'main' : 'first_visit';
        
        if (!hasVisited) {
            localStorage.setItem('marusya_visited', 'true');
        }

        // Показываем диалог с задержкой для загрузки страницы
        setTimeout(() => {
            this.showDialog(dialogId);
        }, 800);
    }

    playDialogSound(type) {
        // Воспроизведение звука с помощью Web Audio API
        try {
            const audioContext = new (window.AudioContext || window.webkitAudioContext)();
            
            const sounds = {
                greeting: { frequency: 523, duration: 0.2 },
                celebration: { frequency: 659, duration: 0.3 },
                achievement: { frequency: 784, duration: 0.4 },
                welcome: { frequency: 440, duration: 0.3 },
                interactive: { frequency: 587, duration: 0.2 },
                default: { frequency: 440, duration: 0.15 }
            };

            const sound = sounds[type] || sounds.default;
            this.playNote(audioContext, sound.frequency, sound.duration);
        } catch (e) {
            // Если звук не поддерживается, игнорируем
        }
    }

    playNote(context, frequency, duration) {
        const oscillator = context.createOscillator();
        const gainNode = context.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(context.destination);
        
        oscillator.frequency.value = frequency;
        oscillator.type = 'sine';
        
        gainNode.gain.setValueAtTime(0.3, context.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, context.currentTime + duration);
        
        oscillator.start(context.currentTime);
        oscillator.stop(context.currentTime + duration);
    }

    trackDialogEvent(event, dialogId, data) {
        // Отправка аналитики
        if (window.gtag) {
            window.gtag('event', event, {
                'dialog_id': dialogId,
                'dialog_data': JSON.stringify(data)
            });
        }

        // Сохраняем в localStorage для статистики
        const stats = JSON.parse(localStorage.getItem('marusya_dialog_stats') || '{}');
        stats[dialogId] = (stats[dialogId] || 0) + 1;
        localStorage.setItem('marusya_dialog_stats', JSON.stringify(stats));
    }

    hasProgress() {
        // Проверяем, есть ли у пользователя прогресс
        const progress = JSON.parse(localStorage.getItem('marusya_progress') || '{}');
        return Object.keys(progress).length > 0;
    }

    // Метод для обновления данных диалога извне
    updateDialogData(data) {
        this.currentData = { ...this.currentData, ...data };
        // Обновляем текст в текущем сообщении
        const container = document.querySelector(this.container);
        const messageText = container.querySelector('.message-text');
        if (messageText && this.currentDialog) {
            let text = this.currentDialog.text;
            Object.keys(data).forEach(key => {
                text = text.replace(`{${key}}`, data[key]);
            });
            // Обновляем текст без анимации
            messageText.innerHTML = this.formatText(text);
        }
    }

    // Получение текущего контекста диалога
    getCurrentContext() {
        return {
            dialogId: this.currentNode,
            dialog: this.currentDialog,
            data: this.currentData,
            history: this.history
        };
    }

    // Сброс истории диалогов
    resetHistory() {
        this.history = [];
        this.variables = {};
        this.flags = {};
    }

    // Экспорт диалогов для использования в других модулях
    exportDialogs() {
        return this.dialogs;
    }

    // Импорт дополнительных диалогов
    importDialogs(newDialogs) {
        this.dialogs = { ...this.dialogs, ...newDialogs };
    }

    // Добавление переменной для использования в диалогах
    setVariable(name, value) {
        this.variables[name] = value;
    }

    // Получение переменной
    getVariable(name) {
        return this.variables[name];
    }

    // Установка флага
    setFlag(name, value = true) {
        this.flags[name] = value;
    }

    // Проверка флага
    getFlag(name) {
        return this.flags[name] || false;
    }
}

