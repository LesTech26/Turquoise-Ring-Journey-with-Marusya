    setupEventListeners() {
        // Глобальные события для вызова диалогов
        document.addEventListener('dialog:show', (e) => {
            const { dialogId, data } = e.detail;
            this.showDialog(dialogId, data);
        });

        document.addEventListener('dialog:hide', () => {
            this.hideDialog();
        });

        document.addEventListener('dialog:update', (e) => {
            const { data } = e.detail;
            if (this.currentDialog) {
                this.updateDialogData(data);
            }
        });

        // Автопоказ приветствия при загрузке
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                this.showInitialDialog();
            }, 1500);
        });

        // Обработка кликов по маскоту
        document.addEventListener('mascot:click', () => {
            if (!this.isActive) {
                this.showDialog('main');
            } else {
                this.mascotReaction('curious');
            }
        });
    }

