class DialogSystem {
    constructor(options = {}) {
        this.container = options.container || '#dialog-container';
        this.mascot = options.mascot || null;
        this.currentDialog = null;
        this.currentNode = null;
        this.history = [];
        this.isActive = false;
        this.typingSpeed = options.typingSpeed || 30;
        this.audioEnabled = options.audioEnabled || true;
        
        this.dialogs = {};
        this.variables = {};
        this.flags = {};
        
        this.init();
    }

    init() {
        this.loadDialogs();
        this.setupEventListeners();
        this.renderContainer();
    }

